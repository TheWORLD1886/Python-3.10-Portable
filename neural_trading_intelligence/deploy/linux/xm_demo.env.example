# Copy to ~/.nti/xm_demo.env and `chmod 600` it. NEVER commit the real file.
# Use a DEMO account. The EA refuses to trade on real accounts.
XM_LOGIN=12345678
XM_PASSWORD=change-me
# Exact server name as shown in XM's account e-mail / MT5 login dialog (e.g. "XMGlobal-MT5 2")
XM_SERVER="XMGlobal-MT5"
# XM spot gold symbol. Check Market Watch: usually GOLD (may carry a suffix on some account types)
XM_SYMBOL=GOLD
